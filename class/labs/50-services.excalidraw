    {
      "id": "Rtigim8R-SDmkP8wld8wD",
      "type": "text",
      "x": 295,
      "y": 672,
      "width": 446.59967041015625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1542585647,
      "version": 86,
      "versionNonce": 322300367,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790711740511,
      "link": null,
      "locked": false,
      "text": "When you use @Service it creates a singleton.\n    - This is OBVIOUSLY a big fat lie.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When you use @Service it creates a singleton.\n    - This is OBVIOUSLY a big fat lie.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "p2T1drg7_M8SVPdGmY0Gu",
      "type": "text",
      "x": 303,
      "y": 948,
      "width": 710.03955078125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1009727041,
      "version": 202,
      "versionNonce": 269827361,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790711881524,
      "link": null,
      "locked": false,
      "text": "On a component:\n    if you add the service to the provider's array, you ALWAYS get a new\n    instance of that service JUST for that component.\n    It's life is bound to life of that component.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On a component:\n    if you add the service to the provider's array, you ALWAYS get a new\n    instance of that service JUST for that component.\n    It's life is bound to life of that component.",
      "autoResize": true,
      "lineHeight": 1.25
    },
