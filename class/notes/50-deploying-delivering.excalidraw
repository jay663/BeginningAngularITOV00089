      "seed": 1397399180,
      "version": 94,
      "versionNonce": 61793972,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790776503569,
      "link": null,
      "locked": false,
      "text": "http 1.0 -  Sir Tim Berners-Lee\nhttp 1.1 - (RFC 2616 - 1999)\n    - Roy T. Fielding\n    - REST ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "http 1.0 -  Sir Tim Berners-Lee\nhttp 1.1 - (RFC 2616 - 1999)\n    - Roy T. Fielding\n    - REST ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "iRgD8dEkBIRiwh2dwtw6l",
      "type": "text",
      "x": 817,
      "y": 583,
      "width": 600.799560546875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 135432716,
      "version": 140,
      "versionNonce": 103959220,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790776900665,
      "link": null,
      "locked": false,
      "text": "JS need to be executed\n    - main.js needs to run to see ANYHTHING\n    - any \"bundle\" over 5mb (uncompressed) gives you an error.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JS need to be executed\n    - main.js needs to run to see ANYHTHING\n    - any \"bundle\" over 5mb (uncompressed) gives you an error.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yQhQBYEBIrXHXdQ4HyjQj",
      "type": "text",
      "x": 782,
      "y": 348,
      "width": 519.2796630859375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 1097751692,
      "version": 259,
      "versionNonce": 149432716,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790776898455,
      "link": null,
      "locked": false,
      "text": "keep main.js as small as possible\n    - create bundles (chunks) for your other features\n        - loadChildren, defer, loadComponent, etc.\n    - write your code to be:\n        - understandable (reveals intention, etc.)\n        - but also \"tree shakable\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "keep main.js as small as possible\n    - create bundles (chunks) for your other features\n        - loadChildren, defer, loadComponent, etc.\n    - write your code to be:\n        - understandable (reveals intention, etc.)\n        - but also \"tree shakable\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
