      "link": null,
      "locked": false,
      "text": "System Tests\n\"black box\" - browser automation, test if your app\ndoes the right thing, independently of how that\nfunctionality is provided.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "QX5NcUC22xsW1vpDn-kCq",
      "originalText": "System Tests\n\"black box\" - browser automation, test if your app  does the right thing, independently of how that functionality is provided.",
      "autoResize": true,
      "lineHeight": 1.25
    },
