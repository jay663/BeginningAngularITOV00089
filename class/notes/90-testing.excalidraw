      "link": null,
      "locked": false,
      "text": "For user interface MANUAL TESTING is the most important thing to start with.\n\nThen do System Tests.\n\nAvoid unit and unit integration tests as much as you can.\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For user interface MANUAL TESTING is the most important thing to start with.\n\nThen do System Tests.\n\nAvoid unit and unit integration tests as much as you can.\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
