      "link": null,
      "locked": false,
      "text": "jeff's rules\n\n- don't ever install new npm packages, unless it is team approved.\n- if you change anything in the root of your angular project, including package.json\n    - this should be approved by EVERYONE. It is a big deal.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "jeff's rules\n\n- don't ever install new npm packages, unless it is team approved.\n- if you change anything in the root of your angular project, including package.json\n    - this should be approved by EVERYONE. It is a big deal.\n",
      "autoResize": true,
      "lineHeight": 1.25
