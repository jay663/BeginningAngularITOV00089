    {
      "id": "wvv1AXtKbvFenIxh-jqM2",
      "type": "text",
      "x": 836,
      "y": 1541,
      "width": 911.299560546875,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1968377099,
      "version": 690,
      "versionNonce": 1778602155,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790625822214,
      "link": null,
      "locked": false,
      "text": "- Change detection \n    - when does Angular update the UI with new values of variables?\n        - user events - forms entered, submitted, text changed, buttons clicked, sliders slid\n\n\n- You call an API and that uses a \"continuation\"\n    - you say \"start this work, and when you are done, here is some more work for you to do\"\n\n\n\nconst promiseToGetCreditLimit = api.getCurrentCustomerCreditLimit();\npromiseToGetCreditLimit.then(r => creditLimit = r);\npromiseToGetCreditLimit.catchError(e => alert(e); );\n\nconsole.log('hello!')\n\n\n{{ creditLimit }}\n\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Change detection \n    - when does Angular update the UI with new values of variables?\n        - user events - forms entered, submitted, text changed, buttons clicked, sliders slid\n\n\n- You call an API and that uses a \"continuation\"\n    - you say \"start this work, and when you are done, here is some more work for you to do\"\n\n\n\nconst promiseToGetCreditLimit = api.getCurrentCustomerCreditLimit();\npromiseToGetCreditLimit.then(r => creditLimit = r);\npromiseToGetCreditLimit.catchError(e => alert(e); );\n\nconsole.log('hello!')\n\n\n{{ creditLimit }}\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HxQXEMM1h5WAs9qTQK3ts",
      "type": "text",
      "x": 1139,
      "y": 2038,
      "width": 312.95977783203125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
